# Port serwera
PORT=3001

# Plik bazy SQLite, względem katalogu projektu
DB_PATH=data/panel.db

# Hasło kont testowych tworzonych przez `npm run seed`. Tylko do uruchomienia lokalnego.
SEED_PASSWORD=demo-serwis-2026

# Ustaw na true, gdy aplikacja działa za HTTPS
SECURE_COOKIES=false

# Ustaw na 1, gdy aplikacja działa za jednym reverse proxy
TRUST_PROXY=0
